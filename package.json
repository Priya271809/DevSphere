{
  "name": "devtinder_backend",
  "version": "1.0.0",
  "description": "tinder for devs",
  "main": "app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev:backend": "nodemon src/app.js",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:frontend": "npm --prefix frontend run build",
    "seed": "node src/utils/seed.js",
    "test:audit": "node src/utils/testApi.js"
  },
  "keywords": [
    "node.js",
    "javascript"
  ],
  "author": "\"Akshay saini\"",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "dotenv": "^18.0.10",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.0.1",
    "node-cron": "^4.2.1",
    "validator": "^13.15.26"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "nodemon": "^3.1.14"
  }
}
